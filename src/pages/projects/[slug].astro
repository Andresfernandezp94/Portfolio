---
import MainLayout from "../../layouts/MainLayout.astro";
import Tag from "../../components/atoms/Tag.astro";
import Section from "../../components/atoms/Section.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getProvider } from "../../data/providers";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    const sorted = projects.sort(
        (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
    );
    return sorted.map((project, i) => ({
        params: { slug: project.id },
        props: {
            project,
            prev: sorted[(i - 1 + sorted.length) % sorted.length],
            next: sorted[(i + 1) % sorted.length],
        },
    }));
}

interface Props {
    project: CollectionEntry<"projects">;
    prev: CollectionEntry<"projects">;
    next: CollectionEntry<"projects">;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);

interface MetaItem {
    label: string;
    value: string;
    href?: string;
}

const meta: MetaItem[] = [];
if (project.data.year) meta.push({ label: "Año", value: project.data.year });
if (project.data.role) meta.push({ label: "Rol", value: project.data.role });
if (project.data.github) {
    meta.push({
        label: "Repo",
        value: "GitHub ↗",
        href: project.data.github,
    });
}
---

<MainLayout
    title={`${project.data.title} | Andres Fernandez`}
    description={project.data.description}
>
    <Section class="pt-32 pb-20">
        <article class="max-w-4xl mx-auto">
            <a
                href="/#proyectos"
                class="inline-flex items-center gap-1 text-sm mb-10"
                style="color: var(--color-accent);"
                aria-label="Volver a la lista de proyectos"
            >
                <span aria-hidden="true">←</span> Volver a Proyectos
            </a>

            <header class="mb-12">
                <h1
                    class="text-3xl md:text-4xl lg:text-5xl font-bold mb-5 text-text leading-tight"
                >
                    {project.data.title}
                </h1>
                <p
                    class="text-lg text-text-secondary mb-6 leading-relaxed"
                >
                    {project.data.description}
                </p>

                {
                    meta.length > 0 && (
                        <dl class="flex flex-wrap gap-2 mb-6">
                            {meta.map((m) => (
                                <div class="meta-pill">
                                    <dt class="meta-label">{m.label}</dt>
                                    <dd class="meta-value">
                                        {m.href ? (
                                            <a
                                                href={m.href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {m.value}
                                            </a>
                                        ) : (
                                            m.value
                                        )}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    )
                }

                <div class="flex flex-wrap gap-1.5">
                    {
                        project.data.stack.map((tech) => {
                            const provider = getProvider(tech);
                            return (
                                <Tag
                                    label={tech}
                                    providerAbbr={provider?.abbr}
                                    providerColor={provider?.color}
                                    providerBg={provider?.bg}
                                />
                            );
                        })
                    }
                </div>
            </header>

            <div class="prose">
                <Content />
            </div>

            <nav
                class="project-nav mt-16 pt-8 border-t border-border"
                aria-label="Navegación entre proyectos"
            >
                <a
                    href={`/projects/${prev.id}`}
                    class="project-nav-link"
                    aria-label={`Proyecto anterior: ${prev.data.title}`}
                >
                    <span class="project-nav-direction">← Anterior</span>
                    <span class="project-nav-title">{prev.data.title}</span>
                </a>
                <a
                    href="/#proyectos"
                    class="project-nav-link text-center"
                    aria-label="Ver todos los proyectos"
                >
                    <span class="project-nav-direction">Todos</span>
                    <span class="project-nav-title">Ver portafolio</span>
                </a>
                <a
                    href={`/projects/${next.id}`}
                    class="project-nav-link text-right"
                    aria-label={`Proyecto siguiente: ${next.data.title}`}
                >
                    <span class="project-nav-direction">Siguiente →</span>
                    <span class="project-nav-title">{next.data.title}</span>
                </a>
            </nav>
        </article>
    </Section>
</MainLayout>
