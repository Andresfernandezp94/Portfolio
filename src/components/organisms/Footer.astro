---
const year = new Date().getFullYear();

const links = [
    { label: "GitHub", href: "https://github.com/Andresfernandezp94" },
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/in/andresfernandezp94",
    },
    {
        label: "Email",
        href: "mailto:andresfernandezp94@gmail.com",
    },
];
---

<footer class="w-full border-t border-border">
    <div
        class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-10 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
    >
        <div
            class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text-muted font-mono"
        >
            <a href="/" class="text-base font-bold text-text">
                AF<span class="text-accent">.</span>
            </a>
            <span>© {year} Andres Fernandez</span>
            <span class="hidden sm:inline">· Construido con Astro & Tailwind</span>
        </div>

        <nav
            aria-label="Links secundarios"
            class="flex flex-wrap gap-x-6 gap-y-1 text-sm"
        >
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="text-text-secondary hover:text-accent transition-colors"
                        rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                        target={link.href.startsWith("http") ? "_blank" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>
</footer>
