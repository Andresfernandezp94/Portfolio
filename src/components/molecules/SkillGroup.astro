---
import Card from "../atoms/Card.astro";
import CardTitle from "../atoms/CardTitle.astro";
import Icon from "../atoms/Icon.astro";

interface Props {
    title: string;
    description: string;
    icon: "cloud" | "data" | "ai" | "hardware" | "signal" | "systems";
    class?: string;
}

const {
    title,
    description,
    icon,
    class: className = "",
} = Astro.props;
---

<Card
    ghost
    interactive={false}
    class:list={["skill-card h-full flex flex-col", className]}
>
    <div class="flex items-start gap-3 mb-3">
        <span
            class="card-icon-tile shrink-0"
        >
            <Icon name={icon} size={18} />
        </span>
        <CardTitle class="mb-0 mt-1">{title}</CardTitle>
    </div>

    <p
        class="text-sm text-text-secondary leading-relaxed flex-1"
    >
        {description}
    </p>
</Card>
