---
import Icon from "../atoms/Icon.astro";

export interface TimelineEntry {
    period: string;
    title: string;
    summary: string;
    topic?: string;
    topicIcon?: string;
}

interface Props {
    items: TimelineEntry[];
    label?: string;
}

const { items, label = "Línea de tiempo" } = Astro.props;
---

<ol class="timeline" aria-label={label}>
    {items.map((entry) => (
        <li class="timeline-item">
            <span class="timeline-dot" aria-hidden="true"></span>
            <time class="timeline-period" datetime={entry.period}>
                {entry.period}
            </time>
            <div class="timeline-content">
                {entry.topic && (
                    <span class="timeline-topic">
                        {entry.topicIcon && (
                            <Icon name={entry.topicIcon} size={11} />
                        )}
                        {entry.topic}
                    </span>
                )}
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
            </div>
        </li>
    ))}
</ol>

<script>
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const timelineItems = Array.from(
        document.querySelectorAll<HTMLElement>(".timeline-item"),
    );

    if (reduceMotion) {
        timelineItems.forEach((el) => el.classList.add("is-visible"));
    } else if ("IntersectionObserver" in window) {
        timelineItems.forEach((el, i) => {
            el.style.setProperty("--item-delay", `${(i % 4) * 120}ms`);
            el.style.setProperty(
                "--content-delay",
                `${120 + (i % 4) * 80}ms`,
            );
        });
        const itemObserver = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        itemObserver.unobserve(entry.target);
                    }
                }
            },
            { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
        );
        timelineItems.forEach((el) => itemObserver.observe(el));
    } else {
        timelineItems.forEach((el) => el.classList.add("is-visible"));
    }

    const timelines = Array.from(
        document.querySelectorAll<HTMLElement>(".timeline"),
    );

    timelines.forEach((tl) =>
        tl.style.setProperty("--timeline-progress", "1"),
    );
</script>