---
import Card from "../atoms/Card.astro";
import CardTitle from "../atoms/CardTitle.astro";
import Icon from "../atoms/Icon.astro";

interface Props {
    name: string;
    description: string | null | undefined;
    icon?: string;
    customIcon?: string;
    href?: string;
    class?: string;
}

const {
    name,
    description,
    icon = "code",
    customIcon,
    href,
    class: className = "",
} = Astro.props;
---

<Card href={href} ghost class:list={["h-full flex flex-col", className]}>
    <div class="flex items-start gap-3 mb-3">
        <span
            class="card-icon-tile shrink-0"
        >
            {
                customIcon ? (
                    <img
                        src={customIcon}
                        alt={`${name} icon`}
                        width="20"
                        height="20"
                        class="w-5 h-5 object-contain"
                    />
                ) : (
                    <Icon name={icon} size={18} />
                )
            }
        </span>
        <CardTitle class="mb-0 mt-1">{name}</CardTitle>
    </div>

    <p
        class="text-sm text-text-secondary leading-relaxed flex-1"
    >
        {description || "Sin descripción"}
    </p>
</Card>
