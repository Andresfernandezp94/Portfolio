---
interface Props {
    label: string;
    href: string;
    class?: string;
    /** Resalta el link cuando apunta a la ruta actual. */
    active?: boolean;
}
const { label, href, class: className = "", active = false } = Astro.props;
---

<a
    href={href}
    aria-current={active ? "page" : undefined}
    class:list={[
        "nav-link text-sm py-2 transition-colors hover:text-text",
        "text-text-secondary md:text-text-secondary",
        active && "is-active text-text",
        className,
    ]}
>
    {label}
</a>
