---
interface Props {
    href: string;
    label: string;
    external?: boolean;
    class?: string;
}

const {
    href,
    label,
    external = false,
    class: className = "",
} = Astro.props;

const target = external ? "_blank" : undefined;
const rel = external ? "noopener noreferrer" : undefined;
---

<a
    href={href}
    target={target}
    rel={rel}
    class:list={["btn", className]}
>
    <slot name="icon" />
    {label}
</a>
