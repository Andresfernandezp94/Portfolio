---
import Icon from "./Icon.astro";

interface Props {
    label: string;
    href?: string;
    providerAbbr?: string;
    providerColor?: string;
    providerBg?: string;
    providerIcon?: string;
    tagIcon?: string;
    tagIconColor?: string;
    class?: string;
}

const {
    label,
    href,
    providerAbbr,
    providerColor,
    providerBg,
    providerIcon,
    tagIcon,
    tagIconColor,
    class: className = "",
} = Astro.props;

const iconColor = tagIconColor ?? providerColor;
---

{href ? (
    <a href={href} class:list={["tag", className]}>
        {tagIcon && (
            <Icon
                name={tagIcon}
                size={11}
                class="shrink-0"
                style={`color: ${iconColor};`}
            />
        )}
        {!tagIcon && providerAbbr && (
            <span
                class="provider-badge"
                style={`color: ${providerColor}; background: ${providerBg};`}
            >
                {providerAbbr}
            </span>
        )}
        {label}
    </a>
) : (
    <span class:list={["tag", className]}>
        {tagIcon && (
            <Icon
                name={tagIcon}
                size={11}
                class="shrink-0"
                style={`color: ${iconColor};`}
            />
        )}
        {!tagIcon && providerAbbr && (
            <span
                class="provider-badge"
                style={`color: ${providerColor}; background: ${providerBg};`}
            >
                {providerAbbr}
            </span>
        )}
        {label}
    </span>
)}
