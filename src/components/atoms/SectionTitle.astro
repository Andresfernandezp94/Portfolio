---
import AccentBar from "./AccentBar.astro";

interface Props {
    title: string;
    id?: string;
    class?: string;
}
const { title, id, class: className = "" } = Astro.props;
---

<div class:list={["mb-2", className]}>
    {id ? <h2 id={id} class="text-3xl font-bold">{title}</h2> : <h2 class="text-3xl font-bold">{title}</h2>}
    <slot name="subtitle" />
</div>
<AccentBar />
