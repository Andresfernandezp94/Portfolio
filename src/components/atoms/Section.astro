---
interface Props {
    id?: string;
    class?: string;
    ariaLabelledby?: string;
}

const {
    id,
    class: className = "",
    ariaLabelledby,
} = Astro.props;
---

<section
    id={id}
    aria-labelledby={ariaLabelledby}
    class:list={["w-full max-w-5xl mx-auto px-6 sm:px-8 lg:px-10", className]}
>
    <slot />
</section>
