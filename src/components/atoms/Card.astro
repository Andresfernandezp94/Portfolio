---
interface Props {
    href?: string;
    class?: string;
    interactive?: boolean;
    ghost?: boolean;
}

const {
    href,
    class: className = "",
    interactive = true,
    ghost = false,
} = Astro.props;

const baseClass = ghost ? "card card-ghost" : "card";
const wrapperClass = interactive ? `${baseClass} card-hover` : baseClass;
---

{
    href ? (
        <a href={href} class:list={[wrapperClass, "block", className]}>
            <slot />
        </a>
    ) : (
        <div class:list={[wrapperClass, className]}>
            <slot />
        </div>
    )
}
