---
interface Props {
    href?: string;
    class?: string;
    interactive?: boolean;
}

const { href, class: className = "", interactive = true } = Astro.props;
const wrapperClass = interactive ? "card card-hover" : "card";
---

{
    href ? (
        <a href={href} class:list={[wrapperClass, "block", className]}>
            <slot />
        </a>
    ) : (
        <div class:list={[wrapperClass, className]}>
            <slot />
        </div>
    )
}
